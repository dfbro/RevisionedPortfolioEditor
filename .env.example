# Optional absolute path to the portfolio website repository.
# This is the only repository the editor can write, commit and push.
# Default: ../RevisionedPortfolio (the maintained production instance).
# PORTFOLIO_REPO_PATH=/path/to/RevisionedPortfolio

# Optional path to the reusable template repository (inspected read-only).
# Default: ../RevisionedPortfolioTemplate relative to this editor repository.
# PORTFOLIO_TEMPLATE_PATH=/path/to/RevisionedPortfolioTemplate

# Push guard: this must match the production repository's origin remote.
# Defaults to https://github.com/dfbro/RevisionedPortfolio.
# EXPECTED_PORTFOLIO_REMOTE=https://github.com/dfbro/RevisionedPortfolio
